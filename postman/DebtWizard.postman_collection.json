{
  "info": {
    "_postman_id": "debtwizard-collection-v3",
    "name": "DebtWizard API",
    "description": "Complete Postman Collection for DebtWizard Spring Boot REST API.\n\nCách dùng:\n1. Import collection này và file environment (DebtWizard - Local)\n2. Chạy Register → Login (token tự động được lưu vào biến accessToken)\n3. Chạy Create Debt → lấy debtId\n4. Chạy các request theo thứ tự trong từng folder\n\nBase URL: http://localhost:8080 (local) hoặc http://13.212.48.231:8080 (production)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",         "value": "http://localhost:8080" },
    { "key": "accessToken",     "value": "" },
    { "key": "refreshToken",    "value": "" },
    { "key": "debtId",          "value": "1" },
    { "key": "paymentId",       "value": "1" },
    { "key": "debtIdToDelete",  "value": "999998", "description": "Dùng cho Delete Debt test — đặt ID này khác debtId để không xóa debt đang dùng cho Planning" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has result.id and username', () => {",
            "  const r = pm.response.json().result;",
            "  pm.expect(r).to.have.property('id');",
            "  pm.expect(r).to.have.property('username');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"monthlyIncome\": 30000000\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register - 400 Validation Error",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('Has field errors in result', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.have.property('result');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"ab\",\n  \"password\": \"123\",\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"monthlyIncome\": -100\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register - 409 Username Already Exists",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 409', () => pm.response.to.have.status(409));",
            "pm.test('ErrorCode is USERNAME_ALREADY_EXISTS', () => {",
            "  pm.expect(pm.response.json().code).to.eql('USERNAME_ALREADY_EXISTS');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\",\n  \"email\": \"other@example.com\",\n  \"monthlyIncome\": 10000000\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },

        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Save tokens to variables', () => {",
            "  const r = pm.response.json().result;",
            "  pm.expect(r).to.have.property('accessToken');",
            "  pm.expect(r).to.have.property('refreshToken');",
            "  pm.collectionVariables.set('accessToken', r.accessToken);",
            "  pm.collectionVariables.set('refreshToken', r.refreshToken);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login - 401 Wrong Credentials",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));",
            "pm.test('ErrorCode is INVALID_CREDENTIALS', () => {",
            "  pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('New accessToken saved', () => {",
            "  const r = pm.response.json().result;",
            "  pm.expect(r).to.have.property('accessToken');",
            "  pm.collectionVariables.set('accessToken', r.accessToken);",
            "  pm.collectionVariables.set('refreshToken', r.refreshToken);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","auth","refresh"] }
          }
        },
        {
          "name": "Refresh Token - 401 Invalid Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));",
            "pm.test('ErrorCode is INVALID_TOKEN', () => {",
            "  pm.expect(pm.response.json().code).to.eql('INVALID_TOKEN');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"invalid.token.here\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","auth","refresh"] }
          }
        },
        {
          "name": "Logout",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Success code', () => { pm.expect(pm.response.json().code).to.eql('SUCCESS'); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] }
          }
        }
      ]
    },

